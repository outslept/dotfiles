#!/usr/bin/env sh
set -eu

if [ -z "${CODESPACES:-}" ] && [ -z "${GITHUB_CODESPACES:-}" ]; then
  if [ "$(git config --bool commit.gpgsign || echo false)" = "true" ] &&
     [ "$(git config gpg.format || echo openpgp)" != "ssh" ]; then
    gpg_bin="$(git config gpg.program || echo gpg)"
    if command -v "$gpg_bin" >/dev/null 2>&1; then
      signing_key="$(git config user.signingkey || true)"
      author_email="$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
      candidate="${signing_key:-$author_email}"

      if ! "$gpg_bin" --list-secret-keys --with-colons --quiet -- "$candidate" 2>/dev/null | grep -q '^sec:'; then
        printf '%s\n' \
          "ERROR: commit signing enabled, but no matching OpenPGP secret key found." \
          "candidate: ${candidate}" \
          "hint: set 'git config user.signingkey <key-id>' or 'git config commit.gpgsign false'." >&2
        exit 1
      fi
    fi
  fi
fi

local_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$local_hook" ]; then
  exec "$local_hook" "$@"
fi
