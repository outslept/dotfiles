{
  "breadcrumbs.filePath": "last",
  "debug.console.fontFamily": "CommitMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Paper Mono",
  "diffEditor.experimental.showMoves": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.autoIndentOnPasteWithinString": false,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeLensFontFamily": "CommitMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Paper Mono",
  "editor.comments.ignoreEmptyLines": false,
  "editor.cursorStyle": "block",
  "editor.definitionLinkOpensInPeek": true,
  "editor.experimental.preferTreeSitter.css": true,
  "editor.experimental.preferTreeSitter.ini": true,
  "editor.experimental.preferTreeSitter.regex": true,
  "editor.experimental.preferTreeSitter.typescript": true,
  "editor.fontFamily": "CommitMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Paper Mono",
  "editor.fontSize": 17.5,
  "editor.guides.bracketPairs": true,
  "editor.guides.highlightActiveIndentation": "always",
  "editor.inlayHints.fontFamily": "CommitMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Paper Mono",
  "editor.letterSpacing": 0.7,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "editor.suggest.preview": true,
  "editor.tabCompletion": "on",
  "markdown.preview.fontFamily": "CommitMono Nerd Font Mono, CaskaydiaCove Nerd Font Mono, Paper Mono",
  "remote.autoForwardPortsSource": "hybrid",
  "search.smartCase": true,
  "semanticdiff.defaultDiffViewer": true,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.smoothScrolling": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "update.enableWindowsBackgroundUpdates": false,
  "window.commandCenter": false,
  "window.newWindowDimensions": "maximized",
  "window.title": "${activeEditorShort}",
  "window.zoomLevel": 0.25,
  "workbench.activityBar.location": "hidden",
  "workbench.colorTheme": "Gruvbox Material Dark",
  "workbench.editor.wrapTabs": true,
  "workbench.iconTheme": "symbols",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.preferredDarkColorTheme": "Gruvbox Material Dark",
  "workbench.preferredLightColorTheme": "Gruvbox Material Light",
  "workbench.reduceMotion": "on",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "zenMode.fullScreen": false
}