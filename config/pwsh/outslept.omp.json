{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "λ ",
          "foreground": "#888888",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "mapped_locations": {
              "~": "~"
            },
            "style": "folder"
          },
          "template": "{{ .Path }}",
          "foreground": "#666666",
          "type": "path",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
