{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#E6E6E6",
          "template": "{{ .Path }}",
          "properties": {
            "style": "folder",
            "mapped_locations": {
              "~": "~"
            }
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#E6E7A3",
          "template": " ({{ .HEAD }}{{ if .Working.Changed }}*{{ end }})",
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#D84F68",
          "template": "{{ if ne .Code 0 }} x{{ end }}",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#54C0A3",
          "template": " $ "
        }
      ]
    }
  ]
}
