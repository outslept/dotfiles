{
  "cli_default_open_behavior": "existing_window",
  "auto_update": false,
  "confirm_quit": true,
  "base_keymap": "VSCode",

  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte"
  },
  "buffer_font_size": 18,
  "cursor_shape": "block",
  "cursor_blink": false,
  "reduce_motion": "on",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 5,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "tab_size": 2,
  "preferred_line_length": 100,

  "use_on_type_format": false,
  "lsp_document_colors": "none",
  "telemetry": { "diagnostics": false, "metrics": false },
  "edit_predictions": { "mode": "subtle" },

  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false
  },
  "title_bar": {
    "show_user_picture": false,
    "show_onboarding_banner": false
  },

  "git_panel": { "dock": "right" },
  "outline_panel": { "dock": "right" },
  "collaboration_panel": { "dock": "right" },
  "project_panel": { "default_width": 280 },
  "agent": { "dock": "right", "enabled": false, "button": false },

  "git": { "inline_blame": { "delay_ms": 300 } },
  "tabs": { "file_icons": true, "git_status": true },
  "preview_tabs": { "enabled": false },
  "close_on_file_delete": true,

  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": false
  },
  "use_smartcase_search": true,

  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/.jj", "**/CVS",
    "**/.DS_Store", "**/Thumbs.db", "**/.classpath", "**/.settings",
    "**/node_modules"
  ],

  "languages": {
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "code_actions_on_format": { "source.organizeImports": true }
    },
    "Make": { "hard_tabs": true },
    "Markdown": { "soft_wrap": "editor_width" },
    "JSON": { "format_on_save": "off" }
  },

  "calls": { "mute_on_join": true },

  "terminal": {
    "default_height": 400,
    "blinking": "off",
    "copy_on_select": true
  }
}
