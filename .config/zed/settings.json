// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_update": false,
  "confirm_quit": true,

  "base_keymap": "VSCode",
  "cursor_shape": "block",

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "agent": {
    "enabled": false,
    "button": false,
  },

  "calls": {
    "mute_on_join": true,
  },

  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },

  "ui_font_size": 16,
  "buffer_font_size": 18,

  "relative_line_numbers": "enabled",

  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  "tab_size": 2,
  "preferred_line_length": 100,

  "project_panel": {
    "dock": "right",
    "default_width": 280,
    "starts_open": true,
    "sticky_scroll": true,
  },

  "outline_panel": {
    "dock": "right",
    "default_width": 300,
  },

  "git": {
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": false,
    },
  },

  "use_smartcase_search": true,

  "inlay_hints": {
    "enabled": true,
  },

  "indent_guides": {
    "enabled": true,
  },

  "terminal": {
    "dock": "bottom",
    "default_height": 400,
    "blinking": "off",
  },
}
