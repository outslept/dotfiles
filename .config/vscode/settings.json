{
  "zenMode.fullScreen": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "breadcrumbs.filePath": "last",
  "debug.console.fontFamily": "Zed Plex Mono",
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeLensFontFamily": "Zed Plex Mono",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.definitionLinkOpensInPeek": true,
  "editor.fontFamily": "Zed Plex Mono",
  "editor.fontSize": 18,
  "editor.inlayHints.fontFamily": "Zed Plex Mono",
  "editor.inlayHints.fontSize": 16,
  "editor.letterSpacing": 0.5,
  "editor.lineHeight": 1.5,
  "workbench.editor.wrapTabs": true,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.tabCompletion": "on",
  "markdown.preview.fontFamily": "Zed Plex Mono",
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontFamily": "Zed Plex Mono",
  "update.enableWindowsBackgroundUpdates": false,
  "update.mode": "manual",
  "window.title": "${activeEditorShort}",
  "workbench.iconTheme": "city-lights-icons-vsc-light",
  "workbench.preferredDarkColorTheme": "Vesper",
  "workbench.sideBar.location": "right",
  "remote.autoForwardPortsSource": "hybrid",
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.startupEditor": "none",
  "window.customTitleBarVisibility": "windowed",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "hidden",
}